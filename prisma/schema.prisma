generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Product {
  id         Int    @id @default(autoincrement())
  sku        String @unique
  name       String
  category   String
  priceCents Int
  stock      Int    @default(0)
}