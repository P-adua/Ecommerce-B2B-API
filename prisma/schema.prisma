generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int    @id @default(autoincrement())
  sku         String @unique
  name        String
  description String
  priceCents  Int
  category    String
  image       String
  warranty    String
  stock       Int    @default(0)

  specInterface String
  specPower     String
  specSpeed     String
  specType      String
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         String @default("BUYER")
  cnpj         String @unique
  companyName  String
  segment      String
}